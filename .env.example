# ==============================================================================
# DATABASE CONFIGURATION (MySQL)
# ==============================================================================
# Spring Boot DB Connection String (Use 'localhost' for local, 'db' or container name for Docker network)
DB_URL=jdbc:mysql://localhost:3306/auth_db

# Database credentials
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Docker Database initialization settings
MYSQL_ROOT_PASSWORD=your_secure_db_password
MYSQL_DATABASE=auth_db


# ==============================================================================
# JWT (JSON WEB TOKEN) SECURITY CONFIGURATION
# ==============================================================================
# Must be a base64-encoded string or high-entropy plain text (At least 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970


# ==============================================================================
# OAUTH2 PROVIDER CREDENTIALS
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client ID & Secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub Developer Settings OAuth App Credentials
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET


# ==============================================================================
# SPRING MAIL / SMTP CONFIGURATION (Gmail Example)
# ==============================================================================
# Gmail SMTP address or provider host
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com

# Gmail 16-character App Password (NOT your personal account password)
SPRING_MAIL_PASSWORD=abcdefghijklmnop


# ==============================================================================
# APPLICATION FRONTEND & DEEP-LINKING
# ==============================================================================
# Frontend origin URL for CORS and Magic Link / Reset Token redirects
APP_FRONTEND_URL=http://localhost:5173
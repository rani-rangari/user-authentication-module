{
  "openapi": "3.0.3",
  "info": {
    "title": "Premium Authentication Starter Kit API",
    "description": "Production-grade authentication, hardware device tracking, passwordless magic links, and audit logging API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Authentication & Identity", "description": "Local signup, login, session refresh, and profile management" },
    { "name": "Passwordless Magic Links", "description": "Token generation and passwordless verification" },
    { "name": "Device & Session Control", "description": "Hardware device tracking, session management, and remote revocation" },
    { "name": "Password Reset", "description": "Self-service email password recovery flow" },
    { "name": "Security & Auditing", "description": "Audit trails and user security logs" }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["Authentication & Identity"],
        "summary": "Register a new user account",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceFingerprintHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account successfully created and session established",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SetCookieAuth" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/EmailConflictError" },
          "422": { "$ref": "#/components/responses/MaxSessionsError" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication & Identity"],
        "summary": "Authenticate local credentials",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceFingerprintHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SetCookieAuth" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/BadCredentialsError" },
          "422": { "$ref": "#/components/responses/MaxSessionsError" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication & Identity"],
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user profile data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfileResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "404": { "$ref": "#/components/responses/UserNotFoundError" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Authentication & Identity"],
        "summary": "Refresh JWT access token using cookie session",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceFingerprintHeader" }
        ],
        "responses": {
          "200": {
            "description": "Tokens successfully refreshed",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SetCookieAuth" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/FingerprintMismatchError" },
          "401": { "$ref": "#/components/responses/ExpiredTokenError" },
          "403": { "$ref": "#/components/responses/SessionRevokedError" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication & Identity"],
        "summary": "Logout current user device and invalidate cookies",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logged out successfully",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/ClearCookieAuth" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardSuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/devices": {
      "get": {
        "tags": ["Device & Session Control"],
        "summary": "List active device sessions",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Active hardware device sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DeviceSessionResponse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      }
    },
    "/api/auth/devices/{id}": {
      "delete": {
        "tags": ["Device & Session Control"],
        "summary": "Revoke specific hardware device session by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the target device session",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardSuccessResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      }
    },
    "/api/auth/devices/others": {
      "delete": {
        "tags": ["Device & Session Control"],
        "summary": "Revoke all other active device sessions",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "All other device sessions terminated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "revokedCount": { "type": "integer", "example": 3 },
                    "message": { "type": "string", "example": "Successfully terminated all other active sessions across networks." }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      }
    },
    "/api/auth/magic-link/request": {
      "post": {
        "tags": ["Passwordless Magic Links"],
        "summary": "Request a passwordless login link via email",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceFingerprintHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MagicLinkRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Magic link email sent if user exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardSuccessResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/auth/magic-link/verify": {
      "post": {
        "tags": ["Passwordless Magic Links"],
        "summary": "Verify magic link token and establish session",
        "parameters": [
          { "$ref": "#/components/parameters/DeviceFingerprintHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string", "example": "4a5c9b...magic-token-hash" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Magic link verified and session created",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SetCookieAuth" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Welcome! Passwordless session established cleanly." },
                    "email": { "type": "string", "format": "email", "example": "user@example.com" },
                    "fullName": { "type": "string", "example": "Alex Taylor" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/FingerprintMismatchError" },
          "410": { "$ref": "#/components/responses/MagicLinkExhaustedError" }
        }
      }
    },
    "/api/auth/password-reset/forgot": {
      "post": {
        "tags": ["Password Reset"],
        "summary": "Request a password reset token via email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email triggered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardSuccessResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/auth/password-reset/confirm": {
      "post": {
        "tags": ["Password Reset"],
        "summary": "Confirm password reset using a reset token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password successfully updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardSuccessResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/auth/audit-logs": {
      "get": {
        "tags": ["Security & Auditing"],
        "summary": "Get paginated security audit logs for the current user",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "severity", "in": "query", "schema": { "type": "string", "enum": ["INFO", "WARN", "CRITICAL", "ALL"] } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit logs",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditLogPageResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "DeviceFingerprintHeader": {
        "name": "X-Device-Fingerprint",
        "in": "header",
        "required": false,
        "description": "Client hardware fingerprint (SHA-256)",
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "SetCookieAuth": {
        "description": "Secure HttpOnly cookies containing access_token and refresh_token",
        "schema": { "type": "string", "example": "access_token=jwt...; Path=/; HttpOnly; Secure; SameSite=Strict" }
      },
      "ClearCookieAuth": {
        "description": "Evicts HttpOnly authentication cookies by setting Max-Age=0",
        "schema": { "type": "string", "example": "access_token=; Path=/; HttpOnly; Secure; Max-Age=0" }
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "fullName": { "type": "string", "minLength": 2, "maxLength": 50, "example": "Alex Taylor" },
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "password": { "type": "string", "minLength": 8, "maxLength": 72, "example": "P@ssw0rd123!" },
          "fingerprint": { "type": "string", "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "password": { "type": "string", "example": "P@ssw0rd123!" },
          "fingerprint": { "type": "string", "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
        }
      },
      "MagicLinkRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "fingerprint": { "type": "string", "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "alex@example.com" }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string", "example": "c7a8e291-872f-48e0-b6a4" },
          "newPassword": { "type": "string", "minLength": 8, "example": "NewStrongPass123!" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Authentication successful" },
          "email": { "type": "string", "example": "alex@example.com" },
          "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiJ9..." },
          "refreshToken": { "type": "string", "example": "d981a54f-1282-4c91-95c5..." },
          "fullName": { "type": "string", "example": "Alex Taylor" },
          "provider": { "type": "string", "example": "LOCAL" }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "email": { "type": "string", "example": "alex@example.com" },
          "fullName": { "type": "string", "example": "Alex Taylor" },
          "role": { "type": "string", "example": "ROLE_USER" },
          "authProvider": { "type": "string", "example": "LOCAL" }
        }
      },
      "DeviceSessionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 12 },
          "ipAddress": { "type": "string", "example": "192.168.1.1" },
          "userAgent": { "type": "string", "example": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)..." },
          "lastActiveAt": { "type": "string", "format": "date-time", "example": "2026-08-11T10:30:00" },
          "isCurrentDevice": { "type": "boolean", "example": true }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 101 },
          "userId": { "type": "integer", "format": "int64", "example": 1 },
          "email": { "type": "string", "example": "alex@example.com" },
          "action": { "type": "string", "example": "LOGIN_SUCCESS" },
          "severity": { "type": "string", "enum": ["INFO", "WARN", "CRITICAL"], "example": "INFO" },
          "ipAddress": { "type": "string", "example": "192.168.1.1" },
          "userAgent": { "type": "string", "example": "Mozilla/5.0..." },
          "deviceFingerprint": { "type": "string", "example": "e3b0c442..." },
          "details": { "type": "string", "example": "User logged in cleanly via local provider" },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-08-11T10:30:00" }
        }
      },
      "AuditLogPageResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuditLog" }
          },
          "totalElements": { "type": "integer", "example": 45 },
          "totalPages": { "type": "integer", "example": 5 },
          "size": { "type": "integer", "example": 10 },
          "number": { "type": "integer", "example": 0 }
        }
      },
      "StandardSuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Operation completed successfully." }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "example": 401 },
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "AUTHENTICATION_FAILED" },
          "message": { "type": "string", "example": "Invalid email or password." },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-08-11T10:32:00" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "example": 400 },
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "VALIDATION_FAILED" },
          "messages": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "example": { "email": "Please provide a valid email address", "password": "Password is required" }
          },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-08-11T10:32:00" }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed on incoming request payload",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Missing or invalid bearer token / unauthenticated session",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
          }
        }
      },
      "BadCredentialsError": {
        "description": "Invalid email or password provided",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 401,
                "success": false,
                "error": "BAD_CREDENTIALS",
                "message": "Invalid email or password.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "ExpiredTokenError": {
        "description": "Refresh or Access Token has expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 401,
                "success": false,
                "error": "TOKEN_EXPIRED",
                "message": "Token has expired.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "SessionRevokedError": {
        "description": "The current hardware device session has been revoked remotely",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 403,
                "success": false,
                "error": "SESSION_REVOKED",
                "message": "This session has been revoked from another device.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "FingerprintMismatchError": {
        "description": "Request hardware fingerprint does not match session hash",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 400,
                "success": false,
                "error": "FINGERPRINT_MISMATCH",
                "message": "Device fingerprint validation failed.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "EmailConflictError": {
        "description": "Account with this email already exists or social provider conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 409,
                "success": false,
                "error": "OAUTH2_EMAIL_CONFLICT",
                "message": "An account with this email already exists.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "MagicLinkExhaustedError": {
        "description": "Magic link has already been used or expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 410,
                "success": false,
                "error": "MAGIC_LINK_EXHAUSTED",
                "message": "This magic link has already been used or pre-fetched. Please request a new one.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "MaxSessionsError": {
        "description": "User active sessions limit (5) reached",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 422,
                "success": false,
                "error": "MAX_SESSIONS_EXCEEDED",
                "message": "Maximum active device limit reached (5/5). Revoke an existing session from your Device Control Center.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      },
      "UserNotFoundError": {
        "description": "User matching criteria was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse",
              "example": {
                "status": 404,
                "success": false,
                "error": "USER_NOT_FOUND",
                "message": "User not found.",
                "timestamp": "2026-08-11T10:32:00"
              }
            }
          }
        }
      }
    }
  }
}